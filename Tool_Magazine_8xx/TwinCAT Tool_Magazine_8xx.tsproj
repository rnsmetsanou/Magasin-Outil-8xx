								<Pdo Name="PSM Controlword for axis" Index="#x1a00" Flags="#x0010" SyncMan="3">
									<Entry Name="Controlword for axis__Non-generative brake order_n" Index="#x6000" Sub="#x01">
										<Type>BIT</Type>
										<Comment><![CDATA[Order for the axis to brake without generating energy back in the power supply module. Active low]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__Ready to operate" Index="#x6000" Sub="#x02">
										<Type>BIT</Type>
										<Comment><![CDATA[High if no errors, mains voltage between tolerances, dc link loaded and relays closed. It allows the axis to be enabled. If this gets low in operation, the axis do not be disabled but rather it avoids the axis to be enabled again.]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__TorqueOFF order_n" Index="#x6000" Sub="#x03">
										<Type>BIT</Type>
										<Comment><![CDATA[Order for the axis to switch off the torque. Active low]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__Generative brake order_n" Index="#x6000" Sub="#x04">
										<Type>BIT</Type>
										<Comment><![CDATA[Order for the axis to brake without demanding energy from the DcLink. Active low]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__Limit dc link current_order_n" Index="#x6000" Sub="#x05">
										<Type>BIT</Type>
										<Comment><![CDATA[Order for the axis to limit the requested current from the DC link. Active low. Cause: Motoric load (6001:04) greater than 102%.]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__NC handling_order_n" Index="#x6000" Sub="#x06">
										<Type>BIT</Type>
										<Comment><![CDATA[Order for the NC to handle. Active low]]></Comment>
									</Entry>
									<Entry Name="Controlword for axis__">
										<Type GUID="{18071995-0000-0000-0000-002000000002}">ARRAY [0..1] OF BIT</Type>
									</Entry>
									<Entry Name="Controlword for axis__">
										<Type GUID="{18071995-0000-0000-0000-002000000003}">ARRAY [0..2] OF BIT</Type>
									</Entry>
									<Entry Name="Controlword for axis__Counter" Index="#x6000" Sub="#x0c">
										<Type>BIT5</Type>
										<Comment><![CDATA[Sign for the axis, that the power supply module is in SAFEOP or OP.]]></Comment>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Warning register" Index="#x1a01" Flags="#x0010">
									<Entry Name="Warning__A0 Reserviert" Index="#x6004" Sub="#x01">
										<Type>BIT</Type>
									</Entry>
									<Entry Name="Warning__A1 Brake resistor power overload" Index="#x6004" Sub="#x02">
										<Type>BIT</Type>
										<Comment><![CDATA[Actual brake power or energy above brake resistor power warning threshold (8000:0D).]]></Comment>
									</Entry>
									<Entry Name="Warning__A2 Device overtemperature" Index="#x6004" Sub="#x03">
										<Type>BIT</Type>
										<Comment><![CDATA[Actual heatsink temperature above heatsink temperature warning threshold (8000:0A).]]></Comment>
									</Entry>
									<Entry Name="Warning__A3 DC link continuous overcurrent" Index="#x6004" Sub="#x04">
										<Type>BIT</Type>
										<Comment><![CDATA[DC link current above DC link continuous overcurrent warning threshold (8000:02).]]></Comment>
									</Entry>
									<Entry Name="Warning__A4 Fan malfunction" Index="#x6004" Sub="#x05">
										<Type>BIT</Type>
										<Comment><![CDATA[Fan does not work.]]></Comment>
									</Entry>
									<Entry Name="Warning__A5 Mains overvoltage" Index="#x6004" Sub="#x06">
										<Type>BIT</Type>
										<Comment><![CDATA[Actual mains voltage above mains voltage max tolerance (8000:07).]]></Comment>
									</Entry>
									<Entry Name="Warning__A6 Mains undervoltage" Index="#x6004" Sub="#x07">
										<Type>BIT</Type>
										<Comment><![CDATA[Actual mains voltage below mains voltage min tolerance (8000:08).]]></Comment>
									</Entry>
									<Entry Name="Warning__">
										<Type GUID="{18071995-0000-0000-0000-002000000001}">ARRAY [0..0] OF BIT</Type>
									</Entry>
									<Entry Name="Warning__">
										<Type GUID="{18071995-0000-0000-0000-002000000008}">ARRAY [0..0] OF BYTE</Type>
									</Entry>
								</Pdo>
