									<Entry Name="Data 1" Index="#x6006" Sub="#x01">
										<Type>DINT</Type>
										<Comment><![CDATA[Actual value of debug pointer 1.]]></Comment>
									</Entry>
									<Entry Name="Data 2" Index="#x6006" Sub="#x02">
										<Type>DINT</Type>
										<Comment><![CDATA[Actual value of debug pointer 2.]]></Comment>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Statusword" Index="#x1a03" Flags="#x0010">
									<Entry Name="Statusword__Ready to operate" Index="#x6007" Sub="#x01">
										<Type>BIT</Type>
										<Comment><![CDATA[High if no errors, mains voltage between tolerances, dc link loaded and relays closed. It allows the axis to be enabled. If this gets low in operation, the axis do not be disabled but rather it avoids the axis to be enabled again.]]></Comment>
									</Entry>
									<Entry Name="Statusword__Error" Index="#x6007" Sub="#x02">
										<Type>BIT</Type>
										<Comment><![CDATA[High if any error is set. To know the error look at the Diag-History.]]></Comment>
									</Entry>
									<Entry Name="Statusword__Warning" Index="#x6007" Sub="#x03">
										<Type>BIT</Type>
										<Comment><![CDATA[High if any warning is set. To know the warning look at the warning register (6002).]]></Comment>
									</Entry>
									<Entry Name="Statusword__Relays closed" Index="#x6007" Sub="#x04">
										<Type>BIT</Type>
										<Comment><![CDATA[High if relays are closed.]]></Comment>
									</Entry>
									<Entry Name="Statusword__Brake chopper active" Index="#x6007" Sub="#x05">
										<Type>BIT</Type>
										<Comment><![CDATA[High if brake chopper is switched on.]]></Comment>
									</Entry>
									<Entry Name="Statusword__Fan active" Index="#x6007" Sub="#x06">
										<Type>BIT</Type>
										<Comment><![CDATA[High if fan is turning.]]></Comment>
									</Entry>
									<Entry Name="Statusword__Reserve 6" Index="#x6007" Sub="#x07">
										<Type>BIT</Type>
									</Entry>
									<Entry Name="Statusword__Reserve 7" Index="#x6007" Sub="#x08">
										<Type>BIT</Type>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Diagnostics" Index="#x1a04" Flags="#x0010">
									<Entry Name="DcLink state machine" Index="#x6005" Sub="#x01">
										<Type>USINT</Type>
										<Comment><![CDATA[Actual state of the DcLink state machine.]]></Comment>
									</Entry>
									<Entry Name="Umains state machine" Index="#x6005" Sub="#x02">
										<Type>USINT</Type>
										<Comment><![CDATA[Actual state of the Umains state machine.]]></Comment>
									</Entry>
									<Entry Name="Error code" Index="#x6005" Sub="#x03">
										<Type>UINT</Type>
										<Comment><![CDATA[This object shall provide the error code of the last error, which occurred in this power supply module.]]></Comment>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Voltages" Index="#x1a05" Flags="#x0010">
									<Entry Name="Actual DC link voltage" Index="#x6001" Sub="#x01">
										<Type>UDINT</Type>
										<Comment><![CDATA[Actual voltage value at the DC link.]]></Comment>
									</Entry>
									<Entry Name="Actual mains voltage" Index="#x6001" Sub="#x02">
										<Type>UDINT</Type>
										<Comment><![CDATA[Actual RMS-value of mains voltage]]></Comment>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Currents" Index="#x1a06" Flags="#x0010">
									<Entry Name="Actual DC link current" Index="#x6002" Sub="#x01">
										<Type>INT</Type>
										<Comment><![CDATA[Actual input current in the dc link. Variable only gets updated when current is higher 0.5A.]]></Comment>
									</Entry>
									<Entry Name="Actual motor load" Index="#x6002" Sub="#x02">
										<Type>UINT</Type>
										<Comment><![CDATA[Actual input load in the dc link in percent of nominal current.]]></Comment>
									</Entry>
								</Pdo>
								<Pdo Name="PSM Process values" Index="#x1a07" Flags="#x0000">
									<Entry Name="Actual brake resistor continuous power" Index="#x6003" Sub="#x01">
										<Type>UINT</Type>
										<Comment><![CDATA[Actual continuous power converted in the brake resistor.]]></Comment>
									</Entry>
									<Entry Name="Actual brake resistor short-time energy" Index="#x6003" Sub="#x02">
										<Type>UINT</Type>
										<Comment><![CDATA[Actual brake energy generated in last second in % of maximal short-time energy (by on-time 1s). Max short-time energy = Continuous max power x Overload factor for 1s x Switch-On-Time (1s).]]></Comment>
									</Entry>
								</Pdo>
								<CoeProfile ProfileNo="62919561" DisplayName="AX8000 Power supply module"/>
