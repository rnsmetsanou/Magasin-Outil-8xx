										<BitOffset>0</BitOffset>
										<Value>0.100000</Value>
										<DefaultValue>0.10</DefaultValue>
										<Access>rw</Access>
										<Description>Defines in which range the Actual Position must lie to the Target Position, that the state is reported as reached.The tolerance is understood as a symmetrical value around the Target Position (+/-Pos tolerance limit switch).</Description>
									</Items>
								</Parameter>
								<Parameter>
									<Name>Tolerance Position Sensor Signal Out (Limit Switch)</Name>
