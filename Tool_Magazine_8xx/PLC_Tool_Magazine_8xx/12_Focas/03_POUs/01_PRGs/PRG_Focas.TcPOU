			iIndex : INT ;
			iDataIndex : INT ;
			
		(** BYTE **)
			byTempBYTE : BYTE ;
			byTypeData : BYTE ;
			byTypePMC : BYTE ;	
			byDataSize : BYTE ;
			byDataBitPos : BYTE ;
		
		(** FLAG **)
			bStartComm : BOOL ;
			bStartFocas : BOOL ;
			bStopFocas : BOOL ;
			bStart : BOOL ;
			bBarLenghtReaded : BOOL ;
		
		(** FB **)
			fb_ConnectionFocas : FB_ConnectionFocas ;
			fb_ReadFocas : FB_ReadFocas ;
			fb_WriteFocas : FB_WriteFocas ;
			tonWaitOpen : TON ;
END_VAR




