TYPE ST_Changing_Arm :
STRUCT
	
	(** ARRAY ST **)
		aGripper : ARRAY[1..2] OF ST_Changing_Arm_Gripper ; // Changing_Arm_Gripper structure
	
	(** ALARMS FLAG **)
		bAlAlarme1 : BOOL ; // Alarme 1 alarm

	(** SETUP FLAG **)
		bAck : BOOL :=FALSE; // Event acknowledgement
		
	(** PROCESS ENUM **)
		ePositionAxis : ENUM_Position_Axis ; // Position of the Changing Arm
	
	(** PROCESS LREAL **)
		lrArmPosition : LREAL ; // Arm position
		lrArmPositionTol : LREAL ; // Arm Position Tolerance
		
		lrArmHome : LREAL ; // Arm coordinate at Home
		lrArmManipulator : LREAL ; // Arm coordinate at transfer position (Arm<->Manipuator)
		lrArmCnc: LREAL ; // Arm coordinate at transfer position (Arm<->Cnc)
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>