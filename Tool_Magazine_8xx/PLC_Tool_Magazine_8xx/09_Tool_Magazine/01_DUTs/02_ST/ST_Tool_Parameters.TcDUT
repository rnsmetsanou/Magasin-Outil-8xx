<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <DUT Name="ST_Tool_Parameters" Id="{9e01665a-8271-4c1e-ae75-226b7cca2caa}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  				ST_Tool_Parameters
//
//								Structure paramètres outil 			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ (inspired by S.FLEURY)
//Création: 14.01.2026
//Dernière modification : 14.01.2026 (G.GOETZ)
//       			
//-----------------------------------------------------------------------------------------
//
//     							Liste des modifications  	
//
// 14.01.2026 (G.GOETZ) -> Création		
//-----------------------------------------------------------------------------------------

TYPE ST_Tool_Parameters : // The order of the structure is important
STRUCT

	Number : DINT ; // Tool Number = Numéro outil
	LifetimeInit : DINT ; // Initial Lifetime of the Tool = Durée de vie initiale
	LifetimeRemain : DINT ; // Remaining Lifetime = Durée de vie restante
    Location : UINT ; // Location of the Tool in the Magazine = Emplacement godet dans magasin
    TwinNumber : BYTE ; // Number of the twin Tool = Numéro outil jumeaux
    Size : BYTE ; // Tool Size = Taille outil
    State :  BYTE ; // Tool State = Etat outil
    FixedLocation : BYTE ; // Fixed Location = Emplacement godet fixe
    LifetimeType : BYTE ; // Lifetime type of the Tool = Type de durée de vie
		UseFlags : BYTE ; // ? = ?
		Options : BYTE ; // ? = ?
	Smax : UDINT ; // Max Speed = Vitesse Max
	Model : UDINT ; // Tool Model = Modèle outil
		TipAngle : UDINT ; // Angle Tip = ?
	ToroidalRadius : UDINT ; // Toroidal Radius = Rayon Torique
	ChamferHeight : UDINT ; // Chamfer height = Hauteur Chanfrein
		ModelFlags : UDINT ; // ? = ?
	TeethNumber : BYTE ; // Number of Teeth = Nombre de dents
	RotationNumberCw : BYTE ; // Number of rotations clockwise = Nombre de tour sens horraire
	RotationNumberCcw : BYTE ; // Number of rotations counter-clockwise = Nombre de tour sens anti-horraire
	ThroughAirBlowTime : UINT ; // Through Air Blow Time = Temps soufflage centre outil
		ListLUserparams : ARRAY[0..3] OF DINT ;
		ListBUserparams : ARRAY [0..3] OF BYTE ;
		TailleMemByt : DINT ; 
		ListCorrecteur : ARRAY[0..44] OF DINT ; //ARRAY[0..(GV_IO.iNbrCorrTool*GV_IO.diNbrElementCorrT)-1] OF DINT; //45 correcteurs en tout dans le pire des cas 9 données *5 correcteurs
		ListCorrToolM : ARRAY[0..4] OF ST_Tool_Corrector_M ;//ARRAY[0..GV_IO.iNbrCorrTool-1] OF ST_CorrecteurM;
		ListCorrToolT : ARRAY[0..4] OF ST_Tool_Corrector_T ;
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>