VAR_GLOBAL PERSISTENT

	(** ALARMS FLAG **)
		bAlLife : BOOL ; // Life bit alarm
		bAlEmergencyStop : BOOL ; // Emergency stop alarm
		bAlNoPower : BOOL ; // No Power alarm
		bAlNoAir : BOOL ; // No Air alarm
		bAlCncFault : BOOL ; // CNC in fault alarm
		bAlCommunication : BOOL ; // Communication alarm
		bAlFocas : BOOL ; // Focas Error
	
	(** SETUP ENUM **)
		eType : ENUM_CNC_Type ; // Type of the CNC
	
	(** SETUP FLAG **)
		bEventAck : BOOL := FALSE ; // Events Acknowledgement
		bPresence : BOOL := FALSE ; // CNC presence or not
		bEnable : BOOL := FALSE ; // CNC enable or not
		bFocas : BOOL := FALSE ; // With Focas or not
		
	(** PROCESS FLAG **)
	
	(** ST **)
		stSpindle : ST_Spindle ; // Spindle structure
		
		stFanucData : ST_CNC_Fanuc_Data ; // Structure CNC Fanuc data
		stHeidenhainData : ST_CNC_Heidenhain_Data ; // Structure CNC Heidenhain data	

END_VAR

VAR_GLOBAL

	(** SETUP INT **)
		iEventGroup : INT := 0 ; // Group for events
	
	(** PROCESS INT **)
		iCommunicationStatus : INT ; // Communication Status with the CNC
	
	(** PROCESS FLAG **)	
		bReady : BOOL ; // CNC is ready
	
	(** ST **)
		stMisc : ST_Miscellaneous ; // Miscellaneous if need

END_VAR

VAR_GLOBAL CONSTANT
	
END_VAR]]></Declaration>
