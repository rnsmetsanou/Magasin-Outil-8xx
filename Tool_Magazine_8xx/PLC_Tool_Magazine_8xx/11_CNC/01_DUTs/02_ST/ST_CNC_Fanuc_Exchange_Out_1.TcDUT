<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <DUT Name="ST_CNC_Fanuc_Exchange_Out_1" Id="{932e5c06-5b6d-4118-a70d-82207c0bf2ac}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  				ST_CNC_Fanuc_Exchange_Out
//
//								Structure Echange Magasin->CNC_Fanuc 			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ (In agreement with J.SPÄTIG)
//Création: 27.01.2026
//Dernière modification : 27.01.2026 (G.GOETZ)
//       			
//-----------------------------------------------------------------------------------------
//
//     							Liste des modifications  	
//
// 27.01.2026 (G.GOETZ) -> Création		
//-----------------------------------------------------------------------------------------

TYPE ST_CNC_Fanuc_Exchange_Out_1 : // 32 Bytes -> Start at X0.0 / End at X31.7 (X0.0+31.7)
STRUCT
	
	(* Byte 0 *)
		byo0 AT %Q* : BYTE ; // Byte X0
			boLife : BIT ; // Magazine Life bit -> X0.0
			boToolAnticipated : BIT ; // Next tool is prepared/anticipated -> X0.1
			boReserve02 : BIT ; // Reserve 02 -> X0.2
			boReserve03 : BIT ; // Reserve 03 -> X0.3
			boReserve04 : BIT ; // Reserve 04 -> X0.4
			boReserve05 : BIT ; // Reserve 05 -> X0.5
			boArmInCncPosition : BIT ; // Loading Arm in position in the CNC -> X0.6
			boNoFault : BIT ; // No Fault on the Magazine -> X0.7

	(* Byte 1 *)
		byo1 AT %Q* : BYTE ; // Byte X1
			boArmOutOfCncArea : BIT ; // Changing Arm out of Cnc area -> X1.0
			boOpenManipulatorGripper : BIT ; // Open the manipulator gripper -> X1.1
			boAirBlowIntermediateDoor : BIT ; // Air blow of the Intermediate Door -> X1.2
			boIntermediateDoorOpen : BIT ; // Intermediate Door is open -> X1.3
			boIntermediateDoorClose : BIT ; // Intermediate Door is close -> X1.4
			boReserve15 : BIT ; // Reserve 15 -> X1.5
			boReserve16 : BIT ; // Reserve 16 -> X1.6
			boReserve17 : BIT ; // Reserve 17 -> X1.7
			
	(* Byte 2 *)
		byo2 AT %Q* : BYTE ; // Byte X2
			boReserve20 : BIT ; // Reserve 20 -> X2.0
			boReserve21 : BIT ; // Reserve 21 -> X2.1
			boReserve22 : BIT ; // Reserve 22 -> X2.2
			boReserve23 : BIT ; // Reserve 23 -> X2.3
			boReserve24 : BIT ; // Reserve 24 -> X2.4
			boReserve25 : BIT ; // Reserve 25 -> X2.5
			boReserve26 : BIT ; // Reserve 26 -> X2.6
			boReserve27 : BIT ; // Reserve 27 -> X2.7
	
	(* Byte 3 *)
		byo3 AT %Q* : BYTE ; // Byte X3
			boReserve30 : BIT ; // Reserve 30 -> X3.0
			boReserve31 : BIT ; // Reserve 31 -> X3.1
			boReserve32 : BIT ; // Reserve 32 -> X3.2
			boReserve33 : BIT ; // Reserve 33 -> X3.3
			boReserve34 : BIT ; // Reserve 34 -> X3.4
			boReserve35 : BIT ; // Reserve 35 -> X3.5
			boReserve36 : BIT ; // Reserve 36 -> X3.6
			boReserve37 : BIT ; // Reserve 37 -> X3.7

	(* Byte 4 *)
		byo4 AT %Q* : BYTE ; // Byte X4
			boReserve40 : BIT ; // Reserve 40 -> X4.0
			boReserve41 : BIT ; // Reserve 41 -> X4.1
			boReserve42 : BIT ; // Reserve 42 -> X4.2
			boReserve43 : BIT ; // Reserve 43 -> X4.3
			boReserve44 : BIT ; // Reserve 44 -> X4.4
			boReserve45 : BIT ; // Reserve 45 -> X4.5
			boReserve46 : BIT ; // Reserve 46 -> X4.6
			boReserve47 : BIT ; // Reserve 47 -> X4.7

	(* Byte 5 *)
		byo5 AT %Q* : BYTE ; // Byte X5
			boReserve50 : BIT ; // Reserve 50 -> X5.0
			boReserve51 : BIT ; // Reserve 51 -> X5.1
			boReserve52 : BIT ; // Reserve 52 -> X5.2
			boReserve53 : BIT ; // Reserve 53 -> X5.3
			boReserve54 : BIT ; // Reserve 54 -> X5.4
			boReserve55 : BIT ; // Reserve 55 -> X5.5
			boReserve56 : BIT ; // Reserve 56 -> X5.6
			boReserve57 : BIT ; // Reserve 57 -> X5.7

	(* Byte 6 *)
		byoResevrve6 AT %Q* : BYTE ; // Byte Reserve 6 -> X6

	(* Byte 7 *)
		byoResevrve7 AT %Q* : BYTE ; // Byte Reserve 7 -> X7

	(* Byte 8-9 *)
		woReserve8 AT %Q* : WORD ; // Word Reserve 8 -> X8-9
	
	(* Byte 10-11 *)
		woReserve10 AT %Q* : WORD ; // Word Reserve 10 -> X10-11

	(* Byte 12-13 *)
		woResevrve12 AT %Q* : WORD ; // Word Reserve 12 -> X12-X13
		
	(* Byte 14-15 *)
		woResevrve14 AT %Q* : WORD ; // Word Reserve 14 -> X14-X15
		
	(* Byte 16 *)
		byoResevrve16 AT %Q* : BYTE ; // Byte Reserve 16 -> X16
		
	(* Byte 17 *)
		byoResevrve17 AT %Q* : BYTE ; // Byte Reserve 17 -> X17
		
	(* Byte 18 *)
		byoResevrve18 AT %Q* : BYTE ; // Byte Reserve 18 -> X18
		
	(* Byte 19 *)
		byoResevrve19 AT %Q* : BYTE ; // Byte Reserve 19 -> X19
		
	(* Byte 20 *)
		byoResevrve20 AT %Q* : BYTE ; // Byte Reserve 20 -> X20
		
	(* Byte 21 *)
		byoResevrve21 AT %Q* : BYTE ; // Byte Reserve 21 -> X21
		
	(* Byte 22 *)
		byoResevrve22 AT %Q* : BYTE ; // Byte Reserve 22 -> X22
		
	(* Byte 23 *)
		byoResevrve23 AT %Q* : BYTE ; // Byte Reserve 23 -> X23
		
	(* Byte 24 *)
		byoResevrve24 AT %Q* : BYTE ; // Byte Reserve 24 -> X24
		
	(* Byte 25 *)
		byoResevrve25 AT %Q* : BYTE ; // Byte Reserve 25 -> X20
		
	(* Byte 26 *)
		byoResevrve26 AT %Q* : BYTE ; // Byte Reserve 26 -> X26
		
	(* Byte 27 *)
		byoResevrve27 AT %Q* : BYTE ; // Byte Reserve 27 -> X27
		
	(* Byte 28 *)
		byoResevrve28 AT %Q* : BYTE ; // Byte Reserve 28 -> X28
		
	(* Byte 29 *)
		byoResevrve29 AT %Q* : BYTE ; // Byte Reserve 29 -> X29
		
	(* Byte 30 *)
		byoResevrve30 AT %Q* : BYTE ; // Byte Reserve 30 -> X30
		
	(* Byte 31 *)
		byoResevrve31 AT %Q* : BYTE ; // Byte Reserve 31 -> X31
		
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>