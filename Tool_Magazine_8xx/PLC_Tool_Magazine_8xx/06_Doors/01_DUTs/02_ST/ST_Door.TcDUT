<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <DUT Name="ST_Door" Id="{7f2aa6ce-ad06-42ed-a0f5-95123de6952b}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  				ST_Door
//
//								Structure porte(s) 			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ (inspired by S.MANTZER)
