VAR_GLOBAL PERSISTENT
END_VAR

VAR_GLOBAL
	
	(** ARRAY ST **)
	aId	: ARRAY[1..iMaxFans] OF ST_Fan ; // Fan Structure
	
	(** REAL **)
	rTempArmor : REAL ; // Temp of the Electrical Armor
	rTempArmorFiltered : REAL ; // Temp Filtered of the Electrical Armor
	
	(** ST **)
	stMisc : ST_Miscellaneous ; // Miscellaneous if need
	
END_VAR

VAR_GLOBAL CONSTANT
	
	(** CONSTANT UINT **)
	uRampStep1 : UINT := 1 ; //  step ramp for the fan accel and decel

	(** CONSTANT INT **)
	iMaxFans : INT := 1 ; // Max Fans
	
