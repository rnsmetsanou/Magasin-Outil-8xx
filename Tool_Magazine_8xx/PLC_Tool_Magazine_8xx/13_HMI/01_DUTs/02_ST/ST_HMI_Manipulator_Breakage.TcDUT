TYPE ST_HMI_Manipulator_Breakage :
STRUCT

	(** SETUP TIME **)
		tTimeout : TIME ; // Value of the timeout for the breakage ctrl
	
	(** SETUP LREAL **)
		lrOffsetSensor : LREAL ; // Offset position above the breakage sensor
		lrToleranceLength : LREAL ; // Tolerance for tool length
		lrMeasureVelocity : LREAL ; // Velocity for the measure

	(** SETUP INT **)
		iTimeout : INT ; // Value of the timeout for the breakage ctrl
	
END_STRUCT
END_TYPE
]]></Declaration>
