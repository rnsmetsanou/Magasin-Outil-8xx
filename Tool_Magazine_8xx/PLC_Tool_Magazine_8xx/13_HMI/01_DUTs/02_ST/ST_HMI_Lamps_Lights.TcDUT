  <DUT Name="ST_HMI_Lamps_Lights" Id="{89a8474f-9dd2-4e09-850e-c8a6ce7a848d}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  			ST_HMI_Lamps_Lights
//
//							Structure voyants et lumières HMI 			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ (inspired by S.MANTZER)
