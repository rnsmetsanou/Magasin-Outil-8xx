STRUCT
	
	(** FLAG + R_Trig **)
		bButtonProject : BOOL ; // Button for Backup Project
			rtButtonProject : R_TRIG ; // Trigger for Backup Project	
	
		bButtonInitData : BOOL ; // Button for Init data of the Export/Import Array
			rtButtonInitData : R_TRIG ; // Trigger for Init data of the Export/Import Array
		bButtonExportData : BOOL ; // Button for Export data
			rtButtonExportData : R_TRIG ; // Trigger for Export data
		bButtonImportData : BOOL ; // Button for Import data
			rtButtonImportData : R_TRIG ; // Trigger for Import data
			
		bButtonExportAlarms : BOOL ; // Button for Export alarms
			rtButtonExportAlarms : R_TRIG ; // Trigger for Export alarms
		bButtonExportMessages : BOOL ; // Button for Export messages
			rtButtonExportMessages : R_TRIG ; // Trigger for Export messages
		
END_STRUCT
