<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <DUT Name="ST_HMI_Magazine_Settings" Id="{a32fb248-6122-4bd0-95f9-cb727b578cc4}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  			ST_HMI_Magazine_Settings
//
//					Structure datas pour la configuration du magasin			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ
//Création: 17.03.2026
//Dernière modification : 17.03.2026 (G.GOETZ)
//       			
//-----------------------------------------------------------------------------------------
//
//     							Liste des modifications  	
//
// 17.03.2026 (G.GOETZ) -> Création		
//-----------------------------------------------------------------------------------------

TYPE ST_HMI_Magazine_Settings :
STRUCT
	
	(** SETUP LREAL **)
		(* Top *)
			lrZAbsCompensationLocationTop : LREAL ; // Z compensation total for the locations at the top in mm
	
			lrXLocationOffsetTop : LREAL ; // X Offset between location at the top of the Magazine
			lrYLocationOffsetTop : LREAL ; // Y Offset between location at the top of the Magazine
			lrZLocationOffsetTop : LREAL ; // Z Offset between location at the top of the Magazine
			
			lrXFirstLocationTop : LREAL ; // X of the first location at the top of the Magazine
			lrYLocationTop : LREAL ; // Y of the Location at the top of the Magazine
			lrZLowestRackTop : LREAL ; // Z of the lowest rack at the top of the Magazine
			
		(* Bottom *)
			lrZAbsCompensationLocationBottom : LREAL ; // Z compensation total for the locations at the bottom in mm
			
			lrXLocationOffsetBottom : LREAL ; // X Offset between location at the bottom of the Magazine
			lrYLocationOffsetBottom : LREAL ; // Y Offset between location at the bottom of the Magazine
			lrZLocationOffsetBottom : LREAL ; // Z Offset between location at the bottom of the Magazine
			
			lrXFirstLocationBottom : LREAL ; // X of the first location at the bottom of the Magazine
			lrYLocationBottom : LREAL ; // Y of the Location at the bottom of the Magazine
			lrZLowestRackBottom : LREAL ; // Z of the first lowest at the bottom of the Magazine
	
	
		lrYOffsetFrontLocation : LREAL ; // Y Offset to be in front of the Y coordinate of the location
		lrZOffsetAboveLocation : LREAL ; // Z Offset to be above of the Z coordinate of the location

		lrZOffsetAboveArmGripper1 : LREAL ; // Z Offset to be above the Z coordinate of the changing arm gripper 1 when in tansfer position
		lrZOffsetAboveArmGripper2 : LREAL ; // Z Offset to be above the Z coordinate of the changing arm gripper 2 when in tansfer position
		
		lrZOffsetToolCheck : LREAL ; // Z Offset above the tool for the check
		lrYOffsetToolCheck : LREAL ; // Y Offset in foront of the tool for the check
	
	(** SETUP REAL **)
		rZBrakeTimer : REAL ; // Timer before brake axis Z 
	
	(** SETUP INT **)
		iMaxRelRackLocationTop : INT ; // Max Location in a Rack in relative at the top of the Magazine
		iMaxRelRackLocationBottom : INT ; // Max Location in a Rack in relative at the bottom of the Magazine
		iMaxRelRackTop : INT ; // Max Rack in relative at the top of the Magazine
		iMaxRelRackBottom : INT ; // Max Rack in relative at the bottom of the Magazine
		
	(** PROCESS FLAG + R_Trig **)
		bButtonSettingsSave : BOOL ; // Button for save the settings of the Magazine and refresh them
			rtSettingsSave : R_Trig ; // Trigger for save the settings of the Magazine and refresh them
			
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>