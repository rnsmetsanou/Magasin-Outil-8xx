TYPE ENUM_Cycle_Step :
(
	InitAll := 0 , // Init All
	InitData := 1 , // Init Data
	Ready := 2 , // Ready
	Preparation := 3 , // Tool Preparation/Anticipation
	BuildSequence := 4 , // Build the Sequence
	ExecuteSequence := 5 , // Execute the Sequence
	End := 7 , // End
	Abort := 8 , // Abort
	Error := 9 // Error
);
END_TYPE
