TYPE ENUM_Cycle_Type :
(
	None := 0 , // None
	LoadSmallBig := 1 , // Load only : small or big tool (A100=small / A200=big)
	UnloadSmall := 2 , // Unload only : small tool (B100=small)
	UnloadBig := 3 , // Unload only : big tool (B200=big)
	LoadSmallUnloadSmall := 4 , // Load : small tool / Unload : small tool (C100=small/small)
	
	//LoadBigUnloadBig := 5 , // Load : big tool / Unload : big tool (D100=big/big)
	//LoadBigUnloadSmall := 6 , // Load : big tool / Unload : small tool (D200=big/small)
	//LoadSmallUnloadBig := 7 , // Load : small tool / Unload : big tool (D300=small/big)

	// Dxxx = Cycle in two step -> "UnloadSmall/Big" and after "LoadSmallBig"

	EssaiType1 := 101 , // EsaiType1

	Essai_1 := 201 ,
	Essai_1_2 := 202 ,
	Essai_1_3 := 203 
	
);
END_TYPE
