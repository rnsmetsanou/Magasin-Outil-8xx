//-----------------------------------------------------------------------------------------
//
//                  				ENUM_Cycle_Action
//
//							Enumération des actions du cycle			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ
//Création: 04.02.2026
//Dernière modification : 04.02.2026 (G.GOETZ)
//       			
//-----------------------------------------------------------------------------------------
//
//     							Liste des modifications  	
//
// 04.02.2026 (G.GOETZ) -> Création		
//-----------------------------------------------------------------------------------------

TYPE ENUM_Cycle_Action :
(
    None := 0 , // No action
    PickToolMagazine := 1 , // Pick tool in magazine with the manipulator head
    ManipulatorToArm := 2 , // Transfer tool from the manipulator head to the changing arm
    ArmCNC := 3 , // Transfer between changing arm and CNC
    ArmToManipulator := 4 , // Transfer tool from the changing arm to the manipulator head
    PlaceToolMagazine := 5 , // Place tool in magazine with the manipulator head
	
	HomePosition := 200 , 
	
	PickPlaceToolMag1 := 211 ,
	PickPlaceToolMag2 := 212 ,
	PickPlaceToolMag3 := 213 ,
	PickPlaceToolMag4 := 214 ,
	PickPlaceToolMag5 := 215
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>