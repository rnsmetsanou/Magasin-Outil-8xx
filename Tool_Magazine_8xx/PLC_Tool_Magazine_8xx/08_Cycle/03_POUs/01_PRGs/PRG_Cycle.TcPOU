<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <POU Name="PRG_Cycle" Id="{83b6ed4b-abd1-416e-8abe-c7e2309dc7ce}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Cycle
VAR
	(** STRING **)
		sTextLog : STRING ; // Text to Log
		sTxtCycleStep : STRING ; // Text of the cycle step in progress
		sTxtCyclePrevStep : STRING ; // Text od the previous cycle step

	(** INT **)
		iLocationLoop : INT := 0 ; // Use in a FOR Loop
		iSequenceLoop : INT := 0 ;  // Use in a FOR Loop
		
	(** FLAG **)
		bInitAllDone : BOOL ; // InitAll is Done
		bInitDataDone : BOOL ; // InitData is Done
		bReadyDone : BOOL ; // Ready is Done
		bPreparationDone : BOOL ; // Preparation/Anticipation is Done
		bBuildSequenceDone : BOOL ; // BuildSequence is Done
		bExecuteSequenceDone : BOOL ; // ExecuteSequence is Done
		bEndDone : BOOL ; // End is Done
		bErrorDone : BOOL ; // Error is Done
		
	(** FB **)
		fb_Init : FB_20_Action_Initialization ;
	
		fb_PickToolMagazine : FB_01_Action_PickToolMagazine ;
		fb_ManipulatorArm : FB_02_Action_TransferManipulatorToArm ;
		fb_ArmCNC : FB_03_Action_TransferArmCnc ;
		fb_ArmManipulator : FB_04_Action_TransferArmToManipulator ;
		fb_PlaceToolMagazine : FB_05_Action_PlaceToolMagazine ;
		
		fb_MagazineCheckOne : FB_10_Action_ToolMagazineCheckOne ;
		fb_MagazineCheckFull : FB_11_Action_ToolMagazineCheckAll ;
		
		tonInit : TON ;
	iRemplissage60: INT;
	bRemplissage60: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  				PRG_Cycle
//
//					Gestion des cycles du magasin d'outils     			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ
//Création: 04.02.2026
//Dernière modification : 09.04.2026 (G.GOETZ)
//       			
//-----------------------------------------------------------------------------------------
//
//     							Liste des modifications  	
//
// 04.02.2026 (G.GOETZ) -> Création	
// 20.02.2026 (G.GOETZ) -> Add : (** CYCLE INIT **)
// 09.04.2026 (G.GOETZ) -> FB modificaiton
//-----------------------------------------------------------------------------------------

// IF bRemplissage60 THEN
// 	FOR iRemplissage60:=1 TO GV_Tool_Magazine.iMaxAbsLocationTop BY 1 DO
// 		GV_Tool_Magazine.aLocation[iRemplissage60].stToolParam.Size:=60;
// 	END_FOR
// 	bRemplissage60:=FALSE;
// END_IF

(** EVENTS **)

(** START/STOP **)
	(* Start *)
		IF GV_General.bSafety AND GV_General.bPower AND GV_General.bAir AND (GV_HMI.stCycle.rtButtonStartStop.Q OR GV_HMI.stCycle.rtButtonStart.Q) AND (NOT GV_Cycle.bStartStop) AND (GV_OpMode.eOpMode=ENUM_OpMode.AUTO OR GV_OpMode.eOpMode=ENUM_OpMode.INIT)  THEN
			GV_Cycle.bStartStop:=TRUE;
		END_IF
	(* Stop *)
		IF ((NOT GV_General.bSafety) OR (NOT GV_General.bPower) OR (NOT GV_General.bAir) OR GV_HMI.stCycle.rtButtonStartStop.Q OR GV_HMI.stCycle.rtButtonStop.Q) AND GV_Cycle.bStartStop AND (GV_OpMode.eOpMode=ENUM_OpMode.AUTO OR GV_OpMode.eOpMode=ENUM_OpMode.INIT)  THEN
			GV_Cycle.bStartStop:=FALSE;
		END_IF

(** ACK **)
	GV_Cycle.bResetError:=GV_HMI.bEventAck;

(** CYCLE INIT **)
	tonInit(PT:=T#1S);
	IF GV_OpMode.eOpMode=ENUM_OpMode.INIT AND GV_Cycle.bStartStop (*AND (NOT GV_Cycle.bInitCycleDone)*) THEN
		
		tonInit.IN:=TRUE;
		GV_Cycle.eCycleStep:=ENUM_Cycle_Step.InitData;
	
		(* Init Step *)
			GV_Cycle.bInitCycleDone:=FALSE;
			bReadyDone:=FALSE;
			bBuildSequenceDone:=FALSE;
			bExecuteSequenceDone:=FALSE;
			GV_Cycle.bAnticipateLoadRequest1:=FALSE;
			GV_Cycle.bAnticipateLoadRequest2:=FALSE;
			GV_Cycle.bAnticipateLoadDone:=FALSE;
			GV_Cycle.bAnticipateUnloadRequest3:=FALSE;
			GV_Cycle.bAnticipateUnloadRequest4:=FALSE;
			GV_Cycle.bActionRunning:=FALSE;
			GV_Cycle.bActionError:=FALSE;
			GV_Cycle.udiErrorID:=0;
		(* Init Sequence *)
			FOR iSequenceLoop:=1 TO GV_Cycle.iMaxActions BY 1 DO
				GV_Cycle.aSequence[iSequenceLoop]:=ENUM_Cycle_Action.None;
			END_FOR
			GV_Cycle.iSeqLength:=0;
			GV_Cycle.iSeqIndex:=1;
		(* Init Cycle *)
			GV_Cycle.eCycleType:=ENUM_Cycle_Type.None;
			GV_Cycle.iSpindleToolLocation:=0;
			GV_Cycle.iToolToLoadLocationAbs:=0;
			GV_Cycle.iToolToLoadLocationRel:=0;
			GV_Cycle.iToolToUnloadLocationAbs:=0;
			GV_Cycle.iToolToUnloadLocationRel:=0;
			GV_Cycle.iToolToCheckLocationAbs:=0;
			GV_Cycle.iArmGripperLoad:=0;
			GV_Cycle.iArmGripperUnload:=0;
			GV_Cycle.bTransferArmToCnc:=FALSE;
			GV_Cycle.iGripperArmToCncNumber:=0;
			GV_Cycle.bTransferCncToArm:=FALSE;
			GV_Cycle.iGripperCncToArmNumber:=0;
		(* Init FB *)
			fb_PickToolMagazine(bInit:=TRUE,bStart:=FALSE);
			fb_ManipulatorArm(bInit:=TRUE,bStart:=FALSE);
			fb_ArmCNC(bInit:=TRUE,bStart:=FALSE);
			fb_ArmManipulator(bInit:=TRUE,bStart:=FALSE);
			fb_PlaceToolMagazine(bInit:=TRUE,bStart:=FALSE);
			fb_MagazineCheckOne(bInit:=TRUE,bStart:=FALSE);
			fb_MagazineCheckFull(bInit:=TRUE,bStart:=FALSE);
		(* Init Axis *)
			GV_Axes.stAxisX.bAutoCmdAbs:=FALSE;
			GV_Axes.stAxisY.bAutoCmdAbs:=FALSE;
			GV_Axes.stAxisZ.bAutoCmdAbs:=FALSE;
			GV_Axes.stAxisArm.bAutoCmdAbs:=FALSE;
		
// 		(* FB_Init *)
// 			IF (NOT GV_Cycle.bInitSet) THEN // Start if not already running
// 				fb_Init.bInit:=TRUE;
// 				GV_Cycle.bInitSet:=TRUE;
// 			END_IF
// 			IF (NOT fb_Init.bInit) AND (NOT fb_Init.bStart) THEN // Start if not already running
// 				fb_Init.bStart:=TRUE;
// 			END_IF
// 			fb_Init( // Call Fb_Action
// 					(*Tunnel*)
// 						tTunnelTimeout:=GV_HMI.stManipulatorTunnel.tTimeout,
// 					(*Step 2*)
// 						tMove2Timeout:=T#0S, // Not used			
// 					);
// 			IF fb_Init.bDone AND (NOT fb_Init.bError) (*tonInit.Q*) THEN
// 				GV_Cycle.bInitSet:=FALSE;
// 				GV_Cycle.bInitCycleDone:=TRUE;
// 				GV_Cycle.bInitRequest:=FALSE;
// 				GV_Cycle.bStartStop:=FALSE;
// 			ELSIF fb_Init.bError THEN
// 				GV_Cycle.bInitSet:=FALSE;
// 				GV_Cycle.bInitCycleDone:=FALSE;
// 			END_IF
			
		IF tonInit.Q THEN
			GV_Cycle.bInitCycleDone:=TRUE;
			GV_Cycle.bInitRequest:=FALSE;
			GV_Cycle.bStartStop:=FALSE;
		ELSE
			GV_Cycle.bInitCycleDone:=FALSE;
		END_IF
	ELSE
		tonInit.IN:=FALSE;
	END_IF

(** CYCLE AUTO **)
	IF GV_OpMode.eOpMode=ENUM_OpMode.AUTO THEN
	
		CASE GV_Cycle.eCycleStep OF
			
			ENUM_Cycle_Step.InitAll: // Step InitAll = 0
				(* Init Step *)
					bInitAllDone:=FALSE;
					bInitDataDone:=FALSE;
					bReadyDone:=FALSE;
					bBuildSequenceDone:=FALSE;
					bExecuteSequenceDone:=FALSE;
					GV_Cycle.bAnticipateLoadRequest1:=FALSE;
					GV_Cycle.bAnticipateLoadRequest2:=FALSE;
					GV_Cycle.bAnticipateLoadDone:=FALSE;
					GV_Cycle.bAnticipateUnloadRequest3:=FALSE;
					GV_Cycle.bAnticipateUnloadRequest4:=FALSE;
					GV_Cycle.bActionRunning:=FALSE;
					GV_Cycle.bActionError:=FALSE;
					GV_Cycle.udiErrorID:=0;
				(* Init Sequence *)
					FOR iSequenceLoop:=1 TO GV_Cycle.iMaxActions BY 1 DO
						GV_Cycle.aSequence[iSequenceLoop]:=ENUM_Cycle_Action.None;
					END_FOR
					GV_Cycle.iSeqLength:=0;
					GV_Cycle.iSeqIndex:=1;
				(* Init Cycle *)
					GV_Cycle.eCycleType:=ENUM_Cycle_Type.None;
					GV_Cycle.iSpindleToolLocation:=0;
					GV_Cycle.iToolToLoadLocationAbs:=0;
					GV_Cycle.iToolToLoadLocationRel:=0;
					GV_Cycle.iToolToUnloadLocationAbs:=0;
					GV_Cycle.iToolToUnloadLocationRel:=0;
					GV_Cycle.iToolToCheckLocationAbs:=0;
					GV_Cycle.iArmGripperLoad:=0;
					GV_Cycle.iArmGripperUnload:=0;
					GV_Cycle.bTransferArmToCnc:=FALSE;
					GV_Cycle.iGripperArmToCncNumber:=0;
					GV_Cycle.bTransferCncToArm:=FALSE;
					GV_Cycle.iGripperCncToArmNumber:=0;
				(* Init FB *)
					fb_Init(bInit:=TRUE,bStart:=FALSE);
					fb_PickToolMagazine(bInit:=TRUE,bStart:=FALSE);
					fb_ManipulatorArm(bInit:=TRUE,bStart:=FALSE);
					fb_ArmCNC(bInit:=TRUE,bStart:=FALSE);
					fb_ArmManipulator(bInit:=TRUE,bStart:=FALSE);
					fb_PlaceToolMagazine(bInit:=TRUE,bStart:=FALSE);
					fb_MagazineCheckOne(bInit:=TRUE,bStart:=FALSE);
					fb_MagazineCheckFull(bInit:=TRUE,bStart:=FALSE);
				(* Init Axis *)
					GV_Axes.stAxisX.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisY.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisZ.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisArm.bAutoCmdAbs:=FALSE;
			
					//Cycle de remise en position Home, automatique ("Home securisé") + fermeture porte intermédiaire ?

					bInitAllDone:=TRUE;
				(* Next Step *)	
					IF bInitAllDone AND GV_Cycle.bStartStop AND GV_Cycle.bInitCycleDone THEN
						GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Ready; // Go to Step Ready
					END_IF
				
			ENUM_Cycle_Step.InitData: // Step InitData = 1
				(* Init Step *)
					bInitAllDone:=FALSE;
					bInitDataDone:=FALSE;
					bReadyDone:=FALSE;
					bBuildSequenceDone:=FALSE;
					bExecuteSequenceDone:=FALSE;
					GV_Cycle.bAnticipateLoadRequest1:=FALSE;
					GV_Cycle.bAnticipateLoadRequest2:=FALSE;
					GV_Cycle.bAnticipateLoadDone:=FALSE;
					GV_Cycle.bAnticipateUnloadRequest3:=FALSE;
					GV_Cycle.bAnticipateUnloadRequest4:=FALSE;
					GV_Cycle.bActionRunning:=FALSE;
					GV_Cycle.bActionError:=FALSE;
					GV_Cycle.udiErrorID:=0;
				(* Init Sequence *)
					FOR iSequenceLoop:=1 TO GV_Cycle.iMaxActions BY 1 DO
						GV_Cycle.aSequence[iSequenceLoop]:=ENUM_Cycle_Action.None;
					END_FOR
					GV_Cycle.eCycleType:=ENUM_Cycle_Type.None;
				(* Init Cycle *)
					GV_Cycle.eCycleType:=ENUM_Cycle_Type.None;
					GV_Cycle.iSpindleToolLocation:=0;
					GV_Cycle.iToolToLoadLocationAbs:=0;
					GV_Cycle.iToolToLoadLocationRel:=0;
					GV_Cycle.iToolToUnloadLocationAbs:=0;
					GV_Cycle.iToolToUnloadLocationRel:=0;
					GV_Cycle.iToolToCheckLocationAbs:=0;
					GV_Cycle.iArmGripperLoad:=0;
					GV_Cycle.iArmGripperUnload:=0;
					GV_Cycle.bTransferArmToCnc:=FALSE;
					GV_Cycle.iGripperArmToCncNumber:=0;
					GV_Cycle.bTransferCncToArm:=FALSE;
					GV_Cycle.iGripperCncToArmNumber:=0;
				(* Init FB *)
					fb_Init(bInit:=TRUE,bStart:=FALSE);
					fb_PickToolMagazine(bInit:=TRUE,bStart:=FALSE);
					fb_ManipulatorArm(bInit:=TRUE,bStart:=FALSE);
					fb_ArmCNC(bInit:=TRUE,bStart:=FALSE);
					fb_ArmManipulator(bInit:=TRUE,bStart:=FALSE);
					fb_PlaceToolMagazine(bInit:=TRUE,bStart:=FALSE);
					fb_MagazineCheckOne(bInit:=TRUE,bStart:=FALSE);
					fb_MagazineCheckFull(bInit:=TRUE,bStart:=FALSE);
				(* Init Axis *)
					GV_Axes.stAxisX.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisY.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisZ.bAutoCmdAbs:=FALSE;
					GV_Axes.stAxisArm.bAutoCmdAbs:=FALSE;
			
					bInitDataDone:=TRUE;
				(* Next Step *)	
					IF bInitDataDone AND GV_Cycle.bStartStop AND GV_Cycle.bInitCycleDone THEN
						GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Ready; // Go to Step Ready
					END_IF
				
			ENUM_Cycle_Step.Ready: // Step Ready = 2
				//IF (NOT GV_Cycle.bStartStop) THEN
				//	(*Log*)
				//		PRG_Log_WM.fbLogWM.M_Write_Log('Cycle Step : 2_Ready=STOP');
				//	GV_Cycle.eCycleStep:=ENUM_Cycle_Step.End; // Go to Step End
				//END_IF
				
				bReadyDone:=FALSE;

				(* CheckMagazineFull *)
					IF GV_Tool_Magazine.bCheckFullMagazineRequest THEN
						IF (NOT fb_MagazineCheckFull.bStart) AND (NOT fb_MagazineCheckFull.bInit) AND (NOT fb_MagazineCheckFull.bBusy) AND (NOT fb_MagazineCheckOne.bBusy) THEN
							fb_MagazineCheckFull.bStart:=TRUE;
						END_IF
						
						IF fb_MagazineCheckFull.bBusy THEN
							fb_MagazineCheckFull.bStart:=FALSE;
						END_IF
						
// 						fb_MagazineCheckFull( // Call Fb_Action
// 											(*ToolLocation*)
// 												lrToolDistance:=GV_HMI.stMagazineCheck.lrToolDistance,
// 												lrToolDistanceTolerance:=GV_HMI.stMagazineCheck.lrToolDistanceTolerance,
// 											(*Manipulator*)
// 												bCheckSensorManipulatorGripper:=GV_HMI.stPickToolMagazine.bCheckSensorManipulatorGripper,
// 											(*Tunnel*)
// 												tTunnelTimeout:=GV_HMI.stManipulatorTunnel.tTimeout,
// 											(*TimeOut*)
// 												tTimeOut:=GV_HMI.stMagazineCheck.tTimeoutOne,
// 											);
						IF fb_MagazineCheckFull.bDone AND (NOT fb_MagazineCheckFull.bError) THEN
							fb_MagazineCheckFull.bStart:=FALSE;
							GV_Tool_Magazine.bCheckFullMagazineRequest:=FALSE;
						ELSIF fb_MagazineCheckFull.bError THEN
							fb_MagazineCheckFull.bStart:=FALSE;
							GV_Cycle.udiErrorID:=21;
							(*Log*)
								PRG_Log_WM.fbLogWM.M_Write_Log('Cycle Step : 2_Ready=Error');
								PRG_Log_WM.fbLogWM.M_Write_Log(CONCAT('Cycle Step : ErrorID=',UDINT_TO_STRING(GV_Cycle.udiErrorID)));
							GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Error; // Go to Step Error
						END_IF
						
					END_IF
				(* CheckMagazineOne *)
					IF GV_Tool_Magazine.bCheckOneMagazineRequest THEN
						
						IF GV_Tool_Magazine.bCheckManipulatorMemoryRequest AND GV_HMI.stMagazineCheck.bCheckManipulatorLocation THEN // Manipulator Request
							GV_Cycle.iToolToCheckLocationAbs:=GV_Tool_Magazine.stManipulator.iAbsLocationNumberMemory;
						ELSIF GV_Tool_Magazine.bCheckArmGripper1MemoryRequest AND GV_HMI.stMagazineCheck.bCheckArmGripper1Location THEN // Arm gripper 1 Request
							GV_Cycle.iToolToCheckLocationAbs:=GV_Tool_Magazine.stArm.aGripper[1].iAbsLocationNumberMemory;
						ELSIF GV_Tool_Magazine.bCheckArmGripper2MemoryRequest AND GV_HMI.stMagazineCheck.bCheckArmGripper2Location THEN // Arm gripper 2 Request
							GV_Cycle.iToolToCheckLocationAbs:=GV_Tool_Magazine.stArm.aGripper[2].iAbsLocationNumberMemory;
						ELSIF GV_Tool_Magazine.bCheckSpindleMemoryRequest AND GV_HMI.stMagazineCheck.bCheckSpindleLocation THEN // Spindle Request
							GV_Cycle.iToolToCheckLocationAbs:=GV_CNC.stSpindle.iAbsLocationNumberMemory;
						ELSE
							GV_Tool_Magazine.bCheckOneMagazineRequest:=FALSE;
							GV_Cycle.iToolToCheckLocationAbs:=0;
						END_IF
						
						IF GV_Tool_Magazine.bCheckOneMagazineRequest AND GV_Cycle.iToolToCheckLocationAbs>0 AND (NOT fb_MagazineCheckOne.bStart) AND (NOT fb_MagazineCheckOne.bInit) AND (NOT fb_MagazineCheckOne.bBusy) AND (NOT fb_MagazineCheckFull.bBusy) THEN
							fb_MagazineCheckOne.bStart:=TRUE;
						END_IF
						IF fb_MagazineCheckOne.bBusy THEN
							fb_MagazineCheckOne.bStart:=FALSE;
						END_IF
// 						fb_MagazineCheckOne( // Call Fb_Action
// 											(*ToolLocation*)
// 												stToolLocation:=GV_Tool_Magazine.aLocation[GV_Cycle.iToolToCheckLocationAbs],
// 												lrToolDistance:=GV_HMI.stMagazineCheck.lrToolDistance,
// 												lrToolDistanceTolerance:=GV_HMI.stMagazineCheck.lrToolDistanceTolerance,
// 											(*Manipulator*)
// 												bCheckSensorManipulatorGripper:=GV_HMI.stPickToolMagazine.bCheckSensorManipulatorGripper,
// 											(*Tunnel*)
// 												tTunnelTimeout:=GV_HMI.stManipulatorTunnel.tTimeout,
// 											(*TimeOut*)
// 												tTimeOut:=GV_HMI.stMagazineCheck.tTimeoutOne,
// 											);
						IF fb_MagazineCheckOne.bDone AND (NOT fb_MagazineCheckOne.bError) THEN
							fb_MagazineCheckOne.bStart:=FALSE;
							IF GV_Tool_Magazine.bCheckManipulatorMemoryRequest AND GV_Cycle.iToolToCheckLocationAbs=GV_Tool_Magazine.stManipulator.iAbsLocationNumberMemory THEN
								GV_Tool_Magazine.bCheckManipulatorMemoryRequest:=FALSE;
							END_IF
							IF GV_Tool_Magazine.bCheckArmGripper1MemoryRequest AND GV_Cycle.iToolToCheckLocationAbs=GV_Tool_Magazine.stArm.aGripper[1].iAbsLocationNumberMemory THEN
								GV_Tool_Magazine.bCheckArmGripper1MemoryRequest:=FALSE;
							END_IF
							IF GV_Tool_Magazine.bCheckArmGripper2MemoryRequest AND GV_Cycle.iToolToCheckLocationAbs=GV_Tool_Magazine.stArm.aGripper[2].iAbsLocationNumberMemory THEN
								GV_Tool_Magazine.bCheckArmGripper2MemoryRequest:=FALSE;
							END_IF
							IF GV_Tool_Magazine.bCheckSpindleMemoryRequest AND GV_Cycle.iToolToCheckLocationAbs=GV_CNC.stSpindle.iAbsLocationNumberMemory THEN
								GV_Tool_Magazine.bCheckSpindleMemoryRequest:=FALSE;
							END_IF
						ELSIF fb_MagazineCheckOne.bError THEN
							fb_MagazineCheckOne.bStart:=FALSE;
							GV_Cycle.udiErrorID:=22;
							(*Log*)
								PRG_Log_WM.fbLogWM.M_Write_Log('Cycle Step : 2_Ready=Error');
								PRG_Log_WM.fbLogWM.M_Write_Log(CONCAT('Cycle Step : ErrorID=',UDINT_TO_STRING(GV_Cycle.udiErrorID)));
							GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Error; // Go to Step Error
						END_IF
						
					END_IF

				(* Ready Done *)
					IF GV_Cycle.bStartStop AND (GV_CNC.stFanucData.stCncMagazine.biToolAnticipation OR ((NOT GV_CNC.stFanucData.stCncMagazine.biToolAnticipation) AND (GV_CNC.stFanucData.stCncMagazine.biLoadRequest OR GV_CNC.stFanucData.stCncMagazine.biUnloadRequest OR GV_CNC.stFanucData.stCncMagazine.biLoadUnloadRequest)))  THEN
						IF (NOT GV_Tool_Magazine.bCheckFullMagazineRequest) AND (NOT GV_Tool_Magazine.bCheckOneMagazineRequest) THEN 
							bReadyDone:=TRUE;
						END_IF
					END_IF
				(* Next Step *)
					IF bReadyDone THEN
						GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Preparation; // Go to Step Preparation
					END_IF

			ENUM_Cycle_Step.Preparation: // Step Preparation = 3
				bPreparationDone:=FALSE;
				GV_Cycle.eCycleType:=ENUM_Cycle_Type.None;
				
// 				(***** PREPARATION/ANTICIPATION *****)
// 				
// 					(* Anticipation - Pick Tool + Manipulator to Arm *)
// 						IF (NOT GV_CNC.stFanucData.stCncMagazine.biLoadRequest) AND (NOT GV_CNC.stFanucData.stCncMagazine.biUnloadRequest) AND (NOT GV_CNC.stFanucData.stCncMagazine.biLoadUnloadRequest) AND
// 						GV_CNC.stFanucData.stCncMagazine.biToolAnticipation AND GV_CNC.stFanucData.iToolToLoadLocation>0 AND (GV_CNC.stFanucData.iToolToLoadType=1 OR GV_CNC.stFanucData.iToolToLoadType=2) AND 
// 						(NOT GV_Tool_Magazine.stManipulator.bToolPresenceMemory) AND (NOT GV_Tool_Magazine.stArm.aGripper[1].bToolPresenceMemory) AND (NOT GV_Tool_Magazine.stArm.aGripper[2].bToolPresenceMemory) AND (NOT GV_Cycle.bAnticipateLoadRequest) AND (NOT GV_Cycle.bAnticipateLoadDone) AND (NOT GV_Cycle.bAnticipateUnloadRequest) THEN
// 					
// 							FOR iLocationLoop:=1 TO GV_Tool_Magazine.iMaxAbsLocation BY 1 DO
// 								IF GV_Tool_Magazine.aLocation[iLocationLoop].iRelLocationNumber=GV_CNC.stFanucData.iToolToLoadLocation AND GV_Tool_Magazine.aLocation[iLocationLoop].bToolPresence AND
// 								GV_Tool_Magazine.aLocation[iLocationLoop].bEnable AND GV_Tool_Magazine.aLocation[iLocationLoop].bUsed AND (NOT GV_Tool_Magazine.aLocation[iLocationLoop].bBlocked) AND (NOT GV_Tool_Magazine.aLocation[iLocationLoop].bForbiden) AND
// 								GV_Tool_Magazine.aLocation[iLocationLoop].eToolType=GV_CNC.stFanucData.iToolToLoadType THEN
// 									GV_Cycle.iToolToLoadLocationAbs:=iLocationLoop;
// 									EXIT;
// 								END_IF
// 							END_FOR
// 							
// 							IF GV_Cycle.iToolToLoadLocationAbs=0 THEN
// 									GV_Cycle.udiErrorID:=31;
// 									(*Log*)
// 										PRG_Log_WM.fbLogWM.M_Write_Log('Cycle Step : 3_Preparation=Error');
// 									PRG_Log_WM.fbLogWM.M_Write_Log(CONCAT('Cycle Step : ErrorID=',UDINT_TO_STRING(GV_Cycle.udiErrorID)));
// 								GV_Cycle.eCycleStep:=ENUM_Cycle_Step.Error; // Go to Step Error
// 							ELSE
// 								GV_Cycle.bAnticipateLoadRequest:=TRUE;
// 								GV_Cycle.iToolToLoadLocationRel:=GV_CNC.stFanucData.iToolToLoadLocation;
// 							END_IF
// 							
// 						END_IF
// 
// 						IF GV_Cycle.bAnticipateLoadRequest AND (NOT GV_Cycle.bAnticipateUnloadRequest) AND GV_Cycle.iToolToLoadLocationAbs>0 THEN
// 					
// 							IF (NOT fb_PickToolMagazine.bStart) AND (NOT fb_PickToolMagazine.bInit) AND (NOT fb_PickToolMagazine.bBusy) AND (NOT fb_ManipulatorArm.bBusy) AND (NOT fb_PlaceToolMagazine.bBusy) AND (NOT fb_ArmManipulator.bBusy) THEN
// 								fb_PickToolMagazine.bStart:=TRUE;
// 								fb_ManipulatorArm.bStart:=FALSE;
// 								fb_PlaceToolMagazine.bStart:=FALSE;
// 								fb_ArmManipulator.bStart:=FALSE;
// 								GV_Cycle.bAnticipateUnLoadDone:=FALSE;
// 							END_IF
// 	
// 							IF fb_PickToolMagazine.bBusy THEN
// 								fb_PickToolMagazine.bStart:=FALSE;
// 							END_IF
