TYPE ENUM_Axis_Select :
(
	None := 0 , // None Axis
	X := 1 , // X Axis
	Y := 2 , // Y Axis
	Z := 3 , // Z Axis 
	Arm := 4 // Changing Arm Axis 
);
END_TYPE
