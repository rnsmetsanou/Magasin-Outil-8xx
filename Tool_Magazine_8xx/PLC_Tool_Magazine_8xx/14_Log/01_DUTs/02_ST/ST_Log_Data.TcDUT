TYPE ST_Log_Data :
STRUCT

	(** ARRAY ST **)
	aBufferLog	: ARRAY[1..GV_log.iMaxLog] OF ST_Log ; // Buffer log	
	
	(** DATE & TIME **)
	dtLastLogDateTimeNewFile : DATE_AND_TIME  ; // Date and TIME
	
	(** INT **)
	iLineIndex : INT := 1 ;
	iFileNumber : INT := 0 ;

	(** FLAG **)	
	bBufferFull : BOOL ;

END_STRUCT
END_TYPE
]]></Declaration>
