VAR_GLOBAL PERSISTENT
END_VAR

VAR_GLOBAL 
	
	(** ARRAY ST **) // Data for HMI
	aEventGroup	: ARRAY[1..GV_Events.iMaxEventGroup] OF ST_EVENT_GROUP ; // Event Group Structure	
	
	(** INT **)
	iEventGroupNumberAssignement : INT := 0 ;
	iEventGroupGeneralEvent : INT := 0 ; 
	iEventGroupCallEvent : INT := 0 ; 
	
END_VAR

VAR_GLOBAL CONSTANT
	
	(** CONSTANT INT **) // Data for HMI
	iMaxEventGroup : INT := 50; // Max EVENT GROUP 1-60 
	iMaxAlarms : INT := 200; // Max Alarms by EVENT GROUP	
	iMaxMessages : INT := 50; // Max Messages by EVENT GROUP			
	iMaxOpMessages : INT := 50; // Max Operator Messages by EVENT GROUP
	
END_VAR

	]]></Declaration>
