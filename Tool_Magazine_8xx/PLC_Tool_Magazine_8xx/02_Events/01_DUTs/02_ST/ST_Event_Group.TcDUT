TYPE ST_Event_Group :
STRUCT
	
	(** ARRAY ST **)
	aAlarm : ARRAY[1..GV_Events.iMaxAlarms] OF ST_Alarm ; // Alarms
	aMessage : ARRAY[1..GV_Events.iMaxMessages] OF ST_Message ; // Messages
	aOpMessage : ARRAY[1..GV_Events.iMaxOPMessages] OF ST_Alarm ; // Operator Messages
	
	(** FLAG **)
	bAlarmPresence : BOOL := FALSE ; // At last one alarm is present/activated
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>