  <DUT Name="ST_Event_Group" Id="{d05658bd-7976-49dc-80b3-b89a69fcf429}">
    <Declaration><![CDATA[//-----------------------------------------------------------------------------------------
//
//                  				ST_Event_Group
//
//								Variables groupe d'évènements 			
//-----------------------------------------------------------------------------------------
//
//Auteur: G.GOETZ (inspired by S.MANTZER)
